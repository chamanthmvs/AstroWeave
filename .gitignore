# Virtual environments
.venv/
venv/
env/

# Python cache and build files
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/

# Test and coverage output
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Local tooling and environment files
.env
.env.*

.DS_Store
.idea/

# Keep shared run/debug configs, but ignore per-user VS Code settings.
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

# Local account records contain password hashes and should not be committed.
app/data/users.json
app/data/astroweave.db
# SQLite write-ahead log and shared-memory files hold recent rows too.
app/data/*.db-shm
app/data/*.db-wal
app/data/*.db-journal

# Agent-oriented project context notes (not for the repo history).
PROJECT_CONTEXT.md
CLAUDE.md