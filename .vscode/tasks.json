{
  // Non-debug way to spin things up. Run a task via Terminal → Run Task…
  //   "▶ AstroWeave: backend (API + chart)" is the default build task (⌘⇧B).
  //   "▶ AstroWeave: full stack" also starts the Next.js web app (needs Node 20+).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Chart service (:8100)",
      "type": "shell",
      "command": "${workspaceFolder}/chart_service/.venv/bin/uvicorn",
      "args": ["main:app", "--port", "8100"],
      "options": { "cwd": "${workspaceFolder}/chart_service" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Application startup complete|Uvicorn running"
        }
      },
      "presentation": { "group": "astroweave", "panel": "dedicated" }
    },
    {
      "label": "Backend API (:8000)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/uvicorn",
      "args": ["astroweave.api.main:app", "--reload", "--port", "8000"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Application startup complete|Uvicorn running"
        }
      },
      "presentation": { "group": "astroweave", "panel": "dedicated" }
    },
    {
      "label": "Web (Next.js :3000)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/web" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Ready in|compiled|started server"
        }
      },
      "presentation": { "group": "astroweave", "panel": "dedicated" }
    },
    {
      "label": "▶ AstroWeave: backend (API + chart)",
      "dependsOn": ["Chart service (:8100)", "Backend API (:8000)"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "▶ AstroWeave: full stack",
      "dependsOn": ["Chart service (:8100)", "Backend API (:8000)", "Web (Next.js :3000)"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "pytest", "-q"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    }
  ]
}
